# Copiá este archivo a .env.local y completalo. Nunca subas .env.local al repo.

# --- Supabase ---
# Local: los valores los imprime `pnpm db:start` (API URL, Publishable y Secret key).
# Producción: Supabase Dashboard > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SOLO servidor. Saltea RLS: nunca le pongas prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Captcha del formulario de consulta (Cloudflare Turnstile) ---
# Producción: Cloudflare Dashboard > Turnstile > Add site. Sin estas dos claves el formulario
# se muestra como "no disponible".
# Para desarrollo sirven las claves de prueba oficiales, que siempre aprueban:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Solo desarrollo/tests sin acceso a Cloudflare: formulario sin captcha (el límite de envíos sigue).
# NUNCA en producción.
# INKFLOW_ALLOW_NO_CAPTCHA=1

# --- Ink Assistant (IA, solo servidor) ---
# Sin AI_API_KEY y AI_MODEL el asistente se muestra como "no disponible" y el panel avisa qué falta.
# Anthropic: console.anthropic.com > API Keys. El modelo se elige explícitamente (ver la lista de
# modelos de Anthropic); no hay uno por defecto para no gastar con un modelo que nadie eligió.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=
# Tope de mensajes por conversación (por defecto 30) y de tokens por mes y estudio (vacío = sin tope).
AI_MAX_MESSAGES_PER_CONVERSATION=30
AI_MONTHLY_TOKEN_BUDGET_PER_WORKSPACE=

# --- Pendientes (se agregan en su fase) ---
# RESEND_API_KEY=                # Fase 2
