# Copiá este archivo a .env.local y completalo. Nunca subas .env.local al repo.

# --- Supabase ---
# Local: los valores los imprime `pnpm db:start` (API URL, Publishable y Secret key).
# Producción: Supabase Dashboard > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SOLO servidor. Saltea RLS: nunca le pongas prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Muestra el panel en producción sin login. SOLO para revisiones internas, nunca en un deploy público.
# INKFLOW_PANEL_PREVIEW=1

# --- Pendientes (se agregan en su fase) ---
# AI_PROVIDER=anthropic          # Fase 4
# AI_API_KEY=                    # Fase 4
# AI_MODEL=                      # Fase 4
# NEXT_PUBLIC_TURNSTILE_SITE_KEY= # Fase 2
# TURNSTILE_SECRET_KEY=          # Fase 2
# RESEND_API_KEY=                # Fase 2
